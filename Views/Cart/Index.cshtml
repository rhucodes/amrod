@{
    ViewData["Title"]       = "Your Cart";
    ViewData["Description"] = "Review your selected items and proceed to checkout.";
}

<section class="cart-page">
    <div class="container">
        <h1>Your Cart</h1>

        <div class="cart-layout">
            <!-- Cart items -->
            <div class="cart-items" id="cart-items">
                <div class="empty-state hidden" id="cart-empty">
                    <p>Your cart is empty.</p>
                    <a href="/" class="btn btn-primary">Browse Products</a>
                </div>
            </div>

            <!-- Order summary -->
            <aside class="cart-summary" id="cart-summary">
                <h2>Order Summary</h2>
                <div class="summary-row">
                    <span>Subtotal</span>
                    <span id="summary-subtotal">R0.00</span>
                </div>
                <div class="summary-row summary-total">
                    <span>Total</span>
                    <span id="summary-total">R0.00</span>
                </div>

                <!-- Checkout form -->
                <div class="checkout-form" id="checkout-form">
                    <h3>Your Details</h3>
                    <input type="text"  id="first-name"  class="input" placeholder="First name"    aria-label="First name" />
                    <input type="text"  id="last-name"   class="input" placeholder="Last name"     aria-label="Last name" />
                    <input type="email" id="email"       class="input" placeholder="Email address" aria-label="Email address" />
                    <input type="tel"   id="phone"       class="input" placeholder="Phone number"  aria-label="Phone number" />
                    <textarea id="notes" class="input" placeholder="Order notes (optional)" aria-label="Order notes" rows="3"></textarea>

                    <div class="form-error hidden" id="form-error" role="alert"></div>

                    <button class="btn btn-primary btn-full" id="checkout-btn" onclick="checkout()">
                        Proceed to Payment
                    </button>
                </div>
            </aside>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/checkout.js" asp-append-version="true"></script>
}