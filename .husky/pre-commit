#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "Running pre-commit checks..."

echo "Building..."
dotnet build --no-restore
if [ $? -ne 0 ]; then
    echo "Build failed. Commit aborted."
    exit 1
fi

echo "Running tests..."
dotnet test --no-build
if [ $? -ne 0 ]; then
    echo "Tests failed. Commit aborted."
    exit 1
fi

echo "All checks passed."